[Unit]
Description=Kvantix energy test: publish the chain head to GitHub (daily anchor)
After=network-online.target kvx-energy-observe.service
Wants=network-online.target

[Service]
Type=oneshot
User=kvxenergy
Group=kvxenergy
RuntimeDirectory=kvx-energy-anchor
Environment="GIT_SSH_COMMAND=ssh -i /root/.ssh/kvx_energy_deploy -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/root/.ssh/known_hosts"
# 1) As the collector's own user: read the chain head (read-only). Running this as root
#    would leave root-owned SQLite WAL files behind and lock the collector out.
ExecStart=/usr/bin/python3 /opt/kvantix/energy/tools/anchor.py snapshot --db /var/lib/kvx-energy/energy.sqlite3 --code /opt/kvantix/energy/kvx_energy.py --out /run/kvx-energy-anchor/head.json
# 2) As root ("!" keeps the sandbox below), because the deploy key is root's: one line, commit, push.
#    The script runs from /opt, never from the clone, so nothing pulled from GitHub is executed.
ExecStart=!/usr/bin/python3 /opt/kvantix/energy/tools/anchor.py publish --snapshot /run/kvx-energy-anchor/head.json --repo /var/lib/kvx-energy-anchor/energinet-forecasts --push
Nice=10
TimeoutStartSec=5min
ProtectSystem=strict
ReadWritePaths=/var/lib/kvx-energy /var/lib/kvx-energy-anchor
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
